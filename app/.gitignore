# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Build output
#
# NOTE: `dist` is deliberately NOT ignored here. This app has no build step —
# app/dist is hand-written source that Rayfin serves verbatim. The Vite
# scaffold this file came from assumed dist was generated; ignoring it would
# publish a repo with no front-end in it.
dist-ssr
*.tsbuildinfo
.vite

# Test coverage
coverage

# Local env files (`*.local` matches `.env.local`, `.env.*.local`, etc.)
*.local

# Rayfin — auto-generated or secret-bearing files
# `rayfin/.env*` covers .env, .env.bak (emitted by env-file v2 migration with
# secrets), and any future .env-family files Rayfin's runtime adds.
rayfin/.env*
rayfin/.deployments.json
rayfin/.temp/

# Editor / OS
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
